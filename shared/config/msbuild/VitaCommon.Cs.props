<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <!-- MSBuildProjectName is available during early package resolution when AssemblyName may still be empty. -->
    <_VitaIntermediateProjectName>$(MSBuildProjectName)</_VitaIntermediateProjectName>
    <!-- WPF creates a randomized project name for its temporary target assembly. Keep that output stable and grouped with its parent project. -->
    <_VitaIsWpfTemporaryProject
      Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('_wpftmp'))"
      >true</_VitaIsWpfTemporaryProject>
    <_VitaIntermediateProjectName Condition=" '$(_VitaIsWpfTemporaryProject)' == 'true' "
      >$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '_[^_]+_wpftmp$', ''))</_VitaIntermediateProjectName>
    <_VitaIntermediateProjectSubdirectory Condition=" '$(_VitaIsWpfTemporaryProject)' == 'true' "
      >wpftmp\</_VitaIntermediateProjectSubdirectory>
    <IntDir>$(VitaObjDir)$(VitaVisualStudioVersion)\$(_VitaIntermediateProjectName)\$(Configuration)\$(Platform)\$(_VitaIntermediateProjectSubdirectory)</IntDir>
    <BaseIntermediateOutputPath>$(IntDir)</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(IntDir)</IntermediateOutputPath>
    <!-- <MSBuildProjectExtensionsPath>$(IntDir)</MSBuildProjectExtensionsPath> -->

    <FileAlignment>512</FileAlignment>
    <TargetFramework Condition="$(TargetFramework)==''">net10.0</TargetFramework>
    <LangVersion Condition=" '$(LangVersion)' == '' ">latest</LangVersion>
    <!-- <TargetFramework>net10.0-windows</TargetFramework> -->
    <!-- <LangVersion>7.3</LangVersion> -->
    <!-- <TargetFramework>netcoreapp2.1</TargetFramework> -->
    <!-- <TargetFrameworks>netcoreapp2.1;net48</TargetFrameworks> -->
    <!--FIXME: Need to figure out what we want to do here, as this format is not compatible with determinis-->
    <!-- <AssemblyVersion>0.0.%2a</AssemblyVersion> -->
  </PropertyGroup>

  <Target Name="VitaCleanWpfTemporaryIntermediates"
          AfterTargets="Clean"
          Condition=" '$(UseWPF)' == 'true' ">
    <RemoveDir Directories="$(IntDir)wpftmp" />
  </Target>

  <PropertyGroup Condition=" '$(VitaUseSolutionFamilyDirs)' == 'false' ">
    <OutDir>$(VitaBinPath)</OutDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(VitaUseSolutionFamilyDirs)' == 'true' ">
    <OutDir>$(VitaSolutionFamilyBinPath)</OutDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(OutDir)</OutputPath>
    <!-- GenerateDocumentationFile makes the compiler validate authored XML comments during every normal build. -->
    <!-- Leave DocumentationFile unset so the SDK writes $(AssemblyName).xml to IntermediateOutputPath. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documentation XML is an intermediate validation artifact, not a build or publish output. -->
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <!-- Package documentation is not a runtime dependency and should not expand application/test outputs. -->
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <!-- CS1591: validate authored documentation without requiring documentation coverage for every public API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Exclude XML sidecars from direct assembly references while preserving symbols, PRI files, and configs. -->
    <AllowedReferenceRelatedFileExtensions>
      .pdb;
      .pri;
      .dll.config;
      .exe.config
    </AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>TRACE;$(DefineConstants)</DefineConstants>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <!--<CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>-->
    <!-- https://github.com/dotnet/roslyn-analyzers/issues/2003: when going from 2_9_8 to 2_9_9 I started getting threw an exception of type 'System.InvalidOperationException' with message 'Feature 'Flow-Analysis' is disabled.'. -->
    <Features>flow-analysis</Features>

  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration.Contains(Debug))' ">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;$(DefineConstants)</DefineConstants>
    <DebugSymbols>true</DebugSymbols>

  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration.Contains(Release))' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(VitaPlatformType)' == 'AnyCPU' ">
    <PlatformTarget>AnyCpu</PlatformTarget>
    <!--Just don't do this shit because AnyCPU on x64 will be ran as 32-bit https://stackoverflow.com/a/39724213/444977-->
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(VitaPlatformType)' == 'x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DefineConstants>_WIN32;$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(VitaPlatformType)' == 'x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>_WIN64;$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <!-- Itanium -->
  <!-- ARM -->

  <ItemGroup>
    <Compile Include="$(VitaRootDir)KSoft\shared\source\KSoftAssemblyInfo.cs">
      <Link>Properties\KSoftAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
