    <!--Because we have tt->cs entries, we need to be explicit about Compile items-->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Source-generation feature flags default off so checked-in T4 output remains the rollback path. -->
    <KSoftGenerateBitsBitCount Condition=" '$(KSoftGenerateBitsBitCount)' == '' ">false</KSoftGenerateBitsBitCount>
    <KSoftGenerateBitsCore Condition=" '$(KSoftGenerateBitsCore)' == '' ">false</KSoftGenerateBitsCore>
    <KSoftGenerateBitsEncoding Condition=" '$(KSoftGenerateBitsEncoding)' == '' ">false</KSoftGenerateBitsEncoding>
    <KSoftGenerateBitsRotate Condition=" '$(KSoftGenerateBitsRotate)' == '' ">false</KSoftGenerateBitsRotate>
    <KSoftGenerateByteSwap Condition=" '$(KSoftGenerateByteSwap)' == '' ">false</KSoftGenerateByteSwap>
