<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>KSoft</RootNamespace>
    <AssemblyName>KSoft</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Keep emitted Roslyn sources under _obj for file-system inspection when a generator feature is active. -->
    <CompilerGeneratedFilesOutputPath
        Condition=" '$(CompilerGeneratedFilesOutputPath)' == '' "
        >$(IntermediateOutputPath)source-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Do not link emitted .g.cs files back into the project; Roslyn owns the semantic generated document view. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- Load KSoft.SourceGeneration as an analyzer only; KSoft must not reference it at runtime. -->
    <ProjectReference Include="$(VitaRootDir)KSoft\KSoft.SourceGeneration\KSoft.SourceGeneration.csproj"
        OutputItemType="Analyzer"
        ReferenceOutputAssembly="False"
        PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
</Project>
