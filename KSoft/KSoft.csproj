<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>KSoft</RootNamespace>
    <AssemblyName>KSoft</AssemblyName>
    <CodeContractsAssemblyMode>1</CodeContractsAssemblyMode>
    <!--Because we have tt->cs entries, we need to be explicit about Compile items-->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Source generation defaults on; pass false explicitly to use checked-in T4 rollback files. -->
    <KSoftUseSourceGeneration Condition=" '$(KSoftUseSourceGeneration)' == '' ">true</KSoftUseSourceGeneration>
    <!-- Keep emitted Roslyn sources under _obj for file-system inspection when a generator feature is active. -->
    <CompilerGeneratedFilesOutputPath
        Condition=" '$(CompilerGeneratedFilesOutputPath)' == '' "
        >$(IntermediateOutputPath)source-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- CompilerVisibleProperty exposes the MSBuild switch to the Roslyn generator as build_property.*. -->
    <CompilerVisibleProperty Include="KSoftUseSourceGeneration" />
  </ItemGroup>
  <ItemGroup>
    <!--
      KSoftGeneratedSource is the single registration point for generated surfaces:
        Include        = logical generated surface name
        RollbackCompile= checked-in T4 .cs file removed from Compile when the generator is active

      Do not link emitted .g.cs files back into the project. Visual Studio opens those physical files as
      miscellaneous/non-semantic documents; the analyzer-generated document view has the correct Roslyn model.
    -->
    <KSoftGeneratedSource Include="BitsBitCount"
        Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">
      <RollbackCompile>Bitwise\_Details\Bits.BitCountT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="BitsBitReverse"
        Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">
      <RollbackCompile>Bitwise\_Details\Bits.BitReverseT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="BitsBitSwap"
        Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">
      <RollbackCompile>Bitwise\_Details\Bits.BitSwapT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
