    <KSoftGenerateBitVectors Condition=" '$(KSoftGenerateBitVectors)' == '' ">false</KSoftGenerateBitVectors>
    <KSoftGenerateIntegerMath Condition=" '$(KSoftGenerateIntegerMath)' == '' ">false</KSoftGenerateIntegerMath>
    <KSoftGenerateEndianStreamsNumbers
        Condition=" '$(KSoftGenerateEndianStreamsNumbers)' == '' ">false</KSoftGenerateEndianStreamsNumbers>
    <KSoftGenerateBitStream Condition=" '$(KSoftGenerateBitStream)' == '' ">false</KSoftGenerateBitStream>
    <!-- Keep emitted Roslyn sources under _obj for file-system inspection when a generator feature is active. -->
    <CompilerGeneratedFilesOutputPath Condition=" '$(CompilerGeneratedFilesOutputPath)' == '' ">$(IntermediateOutputPath)source-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
