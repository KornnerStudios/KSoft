<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>KSoft.IO</RootNamespace>
    <AssemblyName>KSoft.IO.TagElementStreams</AssemblyName>
    <CodeContractsAssemblyMode>1</CodeContractsAssemblyMode>
    <!-- Keep an explicit source list so hand-authored partials and generated surfaces stay reviewable. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Source generation is authoritative for former T4 surfaces. -->
    <KSoftUseSourceGeneration Condition=" '$(KSoftUseSourceGeneration)' == '' ">true</KSoftUseSourceGeneration>
    <!-- Keep emitted Roslyn sources under _obj for file-system inspection when a generator feature is active. -->
    <CompilerGeneratedFilesOutputPath
        Condition=" '$(CompilerGeneratedFilesOutputPath)' == '' "
        >$(IntermediateOutputPath)source-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- CompilerVisibleProperty exposes the MSBuild switch to the Roslyn generator as build_property.*. -->
    <CompilerVisibleProperty Include="KSoftUseSourceGeneration" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Do not link emitted .g.cs files back into the project; Roslyn owns the semantic generated document view. -->
    <KSoftSourceGenerationEnabled Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">true</KSoftSourceGenerationEnabled>
    <KSoftSourceGenerationEnabled
        Condition=" '$(KSoftSourceGenerationEnabled)' == '' ">false</KSoftSourceGenerationEnabled>
    <EmitCompilerGeneratedFiles
        Condition=" '$(KSoftSourceGenerationEnabled)' == 'true' ">true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DefaultSerializers\Collections.cs" />
    <Compile Include="DefaultSerializers\GroupTags.cs" />
    <Compile Include="ITagElementStreamable.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="TagElementStream.cs" />
    <Compile Include="TagElementStream.Read.cs" />
    <Compile Include="TagElementStream.Serialize.cs" />
    <Compile Include="TagElementStream.Write.cs" />
    <Compile Include="TagElementStreamBookmark.cs" />
    <Compile Include="TagElementStreamFactory.cs" />
    <Compile Include="TagElementStreamFormat.cs" />
    <Compile Include="TypeExtensions.cs" />
    <Compile Include="Xml\XmlElementStream.cs" />
    <Compile Include="Xml\XmlElementStream.Read.cs" />
    <Compile Include="Xml\XmlElementStream.Write.cs" />
    <Compile Include="DefaultSerializers\Shell.cs" />
    <Compile Include="_DetailsText\TagElementTextStream.cs" />
    <Compile Include="_DetailsText\TagElementTextStream.Read.cs" />
    <Compile Include="_DetailsText\TagElementTextStream.Write.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(VitaRootDir)KSoft\KSoft\KSoft.csproj">
      <Project>{eb07f515-e27c-4768-8bd8-2829f657807e}</Project>
      <Name>KSoft</Name>
      <Private>False</Private>
    </ProjectReference>
    <!-- Load KSoft.SourceGeneration as an analyzer only; this project must not reference it at runtime. -->
    <ProjectReference Include="$(VitaRootDir)KSoft\KSoft.SourceGeneration\KSoft.SourceGeneration.csproj"
        Condition=" '$(KSoftUseSourceGeneration)' == 'true' "
        OutputItemType="Analyzer"
        ReferenceOutputAssembly="False"
        PrivateAssets="all" />
  </ItemGroup>
</Project>
