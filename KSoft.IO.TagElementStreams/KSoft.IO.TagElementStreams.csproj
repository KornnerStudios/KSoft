<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>KSoft.IO</RootNamespace>
    <AssemblyName>KSoft.IO.TagElementStreams</AssemblyName>
    <CodeContractsAssemblyMode>1</CodeContractsAssemblyMode>
    <!--Because we have tt->cs entries, we need to be explicit about Compile items-->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Source-generation feature flags default on; pass false explicitly to use checked-in T4 rollback files. -->
    <KSoftGenerateTagElementStreams
        Condition=" '$(KSoftGenerateTagElementStreams)' == '' ">true</KSoftGenerateTagElementStreams>
    <!-- Keep emitted Roslyn sources under _obj for file-system inspection when a generator feature is active. -->
    <CompilerGeneratedFilesOutputPath
        Condition=" '$(CompilerGeneratedFilesOutputPath)' == '' "
        >$(IntermediateOutputPath)source-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- CompilerVisibleProperty exposes MSBuild feature flags to the Roslyn generator as build_property.* values. -->
    <KSoftSourceGenerationProperty Include="KSoftGenerateTagElementStreams" />
    <CompilerVisibleProperty Include="@(KSoftSourceGenerationProperty)" />
  </ItemGroup>
  <ItemGroup>
    <!--
      KSoftGeneratedSource is the single registration point for generated surfaces:
        Include        = logical generated surface name
        RollbackCompile= checked-in T4 .cs file removed from Compile when the generator is active
    -->
    <KSoftGeneratedSource Include="TagElementTextStreamRead"
        Condition=" '$(KSoftGenerateTagElementStreams)' == 'true' ">
      <RollbackCompile>_Details\TagElementTextStream.ReadT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="TagElementTextStreamWrite"
        Condition=" '$(KSoftGenerateTagElementStreams)' == 'true' ">
      <RollbackCompile>_Details\TagElementTextStream.WriteT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="TagElementStreamRead"
        Condition=" '$(KSoftGenerateTagElementStreams)' == 'true' ">
      <RollbackCompile>_Details\TagElementStream.ReadT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="TagElementStreamSerialize"
        Condition=" '$(KSoftGenerateTagElementStreams)' == 'true' ">
      <RollbackCompile>_Details\TagElementStream.SerializeT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="TagElementStreamWrite"
        Condition=" '$(KSoftGenerateTagElementStreams)' == 'true' ">
      <RollbackCompile>_Details\TagElementStream.WriteT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
  </ItemGroup>
  <PropertyGroup>
    <!-- Any active KSoftGeneratedSource emits .g.cs files and removes the corresponding rollback Compile item. -->
    <KSoftGeneratedSourceItems>@(KSoftGeneratedSource)</KSoftGeneratedSourceItems>
    <KSoftSourceGenerationEnabled Condition=" '$(KSoftGeneratedSourceItems)' != '' ">true</KSoftSourceGenerationEnabled>
    <KSoftSourceGenerationEnabled
        Condition=" '$(KSoftSourceGenerationEnabled)' == '' ">false</KSoftSourceGenerationEnabled>
    <EmitCompilerGeneratedFiles
        Condition=" '$(KSoftSourceGenerationEnabled)' == 'true' ">true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DefaultSerializers\Collections.cs" />
    <Compile Include="DefaultSerializers\GroupTags.cs" />
    <Compile Include="ITagElementStreamable.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="TagElementStream.cs" />
    <Compile Include="TagElementStream.Read.cs" />
    <Compile Include="TagElementStream.Serialize.cs" />
    <Compile Include="TagElementStream.Write.cs" />
    <Compile Include="TagElementStreamBookmark.cs" />
    <Compile Include="TagElementStreamFactory.cs" />
    <Compile Include="TagElementStreamFormat.cs" />
    <Compile Include="TypeExtensions.cs" />
    <Compile Include="Xml\XmlElementStream.cs" />
    <Compile Include="Xml\XmlElementStream.Read.cs" />
    <Compile Include="Xml\XmlElementStream.Write.cs" />
    <Compile Include="DefaultSerializers\Shell.cs" />
    <Compile Include="_DetailsText\TagElementTextStream.cs" />
    <Compile Include="_DetailsText\TagElementTextStream.Read.cs" />
    <Compile Include="_Details\TagElementTextStream.ReadT4.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TagElementTextStream.ReadT4.tt</DependentUpon>
    </Compile>
    <Compile Include="_DetailsText\TagElementTextStream.Write.cs" />
    <Compile Include="_Details\TagElementTextStream.WriteT4.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TagElementTextStream.WriteT4.tt</DependentUpon>
    </Compile>
    <Compile Include="_Details\TagElementStream.ReadT4.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TagElementStream.ReadT4.tt</DependentUpon>
    </Compile>
    <Compile Include="_Details\TagElementStream.SerializeT4.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TagElementStream.SerializeT4.tt</DependentUpon>
    </Compile>
    <Compile Include="_Details\TagElementStream.WriteT4.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TagElementStream.WriteT4.tt</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(VitaRootDir)KSoft\KSoft\KSoft.csproj">
      <Project>{eb07f515-e27c-4768-8bd8-2829f657807e}</Project>
      <Name>KSoft</Name>
      <Private>False</Private>
    </ProjectReference>
    <!-- Load KSoft.SourceGeneration as an analyzer only; this project must not reference it at runtime. -->
    <ProjectReference Include="$(VitaRootDir)KSoft\KSoft.SourceGeneration\KSoft.SourceGeneration.csproj"
        OutputItemType="Analyzer"
        ReferenceOutputAssembly="False"
        PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Remove checked-in T4 rollback files when the matching Roslyn feature is active. -->
    <Compile Remove="@(KSoftGeneratedSource->'%(RollbackCompile)')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="_Details\TagElementTextStream.ReadT4.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TagElementTextStream.ReadT4.cs</LastGenOutput>
    </None>
    <None Include="_Details\TagElementTextStream.WriteT4.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TagElementTextStream.WriteT4.cs</LastGenOutput>
    </None>
    <None Include="_Details\TagElementStream.ReadT4.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TagElementStream.ReadT4.cs</LastGenOutput>
    </None>
    <None Include="_Details\TagElementStream.SerializeT4.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TagElementStream.SerializeT4.cs</LastGenOutput>
    </None>
    <None Include="_Details\TagElementStream.WriteT4.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TagElementStream.WriteT4.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
