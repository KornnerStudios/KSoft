        Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">
      <RollbackCompile>Bitwise\_Details\Bits.ConstantsT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="BitsCore"
        Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">
      <RollbackCompile>Bitwise\_Details\BitsT4.cs</RollbackCompile>
    </KSoftGeneratedSource>
    <KSoftGeneratedSource Include="BitsVectors"
        Condition=" '$(KSoftUseSourceGeneration)' == 'true' ">
